# PostgreSQL 15+ connection string. The role must be able to run migrations
# (create tables, functions and the `framework_app` role).
DATABASE_URL=postgres://framework:framework@127.0.0.1:5432/framework_dev

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin of the app, without a trailing slash.
APP_URL=http://localhost:3000

# File storage for the Visual Library (M3). See docs/adr/0006-object-storage.md.
# "filesystem" (default) stores files under STORAGE_DIR: local development or a single server
# with a persistent disk. "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Tigris,
# Garage, RustFS...). The bucket must be private; the app serves every file itself.
STORAGE_DRIVER=filesystem
STORAGE_DIR=.storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=

# PostgreSQL 15+ connection string. The role must be able to run migrations
# (create tables, functions and the `framework_app` role).
DATABASE_URL=postgres://framework:framework@127.0.0.1:5432/framework_dev

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin of the app, without a trailing slash.
APP_URL=http://localhost:3000
